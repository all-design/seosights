// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Existing Models ────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  passwordHash          String?   // bcrypt hashed password (null for OAuth-only users)
  role                  String    @default("user") // user | agency | affiliate | superadmin
  avatarUrl             String?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?
  subscriptionStatus    String    @default("free_trial") // free_trial | active | past_due | canceled
  tier                  String    @default("free_trial") // free_trial | starter | pro | managed
  lastLoginAt           DateTime?

  // ─── Agency White-Label Branding (Pro+ feature) ──────────────────────
  agencyName            String?   // e.g. "Apex Digital Agency"
  agencyLogoUrl         String?   // e.g. "https://cdn.apex.com/logo.png"
  agencyPrimaryColor    String    @default("#10b981") // HEX code for CSS — default emerald
  agencySecondaryColor  String    @default("#6B7280") // HEX code for CSS — default gray
  agencyAccentColor     String    @default("#f59e0b") // HEX code for CSS — default amber

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // ─── Affiliate System ────────────────────────────────────────────────
  referredByAffiliateId String?  // ID of the affiliate who referred this user

  sessions        Session[]
  analyses        Analysis[]
  projects        Project[]
  webhooks        WebhookConfig[]
  alerts          VisibilityAlert[]
  tokenUsageLogs  TokenUsageLog[]
  affiliate       Affiliate?
  visibilitySnapshots   VisibilitySnapshot[]
  citationEvents        CitationEvent[]
  feedItems             FeedItem[]
  actionItems           ActionItem[]
  recommendationSnapshots RecommendationSnapshot[]
  replaySessions        ReplaySession[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  website   String?
  createdAt DateTime @default(now())
}

// ─── New Models ─────────────────────────────────────────────────────

model Analysis {
  id        String   @id @default(cuid())
  url       String
  domain    String
  market    String   @default("Global")
  status    String   @default("pending") // pending | running | completed | failed
  mode      String   @default("auto-pilot") // auto-pilot | co-pilot
  userId    String?
  projectId String?
  result    String?  // JSON string of full analysis result
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id])
  agentLogs      AgentLog[]
  approvals      Approval[]
  tokenUsageLogs TokenUsageLog[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([domain])
}

model AgentLog {
  id           String    @id @default(cuid())
  analysisId   String
  agentId      String    // e.g. "master-director", "keyword-researcher"
  agentName    String    // e.g. "Master Director"
  action       String    // what the agent is doing, e.g. "Scanning Perplexity mentions..."
  status       String    // running | completed | failed
  tokensUsed   Int       @default(0)
  costUsd      Float     @default(0)
  model        String    @default("default")
  result       String?   // JSON string of agent result
  error        String?   // error message if failed
  startedAt    DateTime
  completedAt  DateTime?

  analysis     Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([agentId])
  @@index([status])
}

model Approval {
  id               String    @id @default(cuid())
  analysisId       String
  agentId          String    // which agent produced the action
  agentName        String
  actionType       String    // e.g. "meta-tag-change", "content-publish", "robots-update"
  actionDescription String   // what the agent wants to do
  actionData       String    // JSON string with the proposed change details
  status           String    @default("pending") // pending | approved | rejected | expired
  reviewedAt       DateTime?
  reviewedBy       String?   // user who reviewed
  createdAt        DateTime  @default(now())

  analysis         Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([status])
  @@index([actionType])
}

model AgentPrompt {
  id                 String   @id @default(cuid())
  agentId            String   @unique // e.g. "master-director"
  agentName          String
  systemPrompt       String   // the system prompt text
  userPromptTemplate String   // the user prompt template with {{variables}}
  model              String   @default("default") // primary LLM model
  fallbackModel      String?  // fallback model if primary fails
  isActive           Boolean  @default(true)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([agentId])
  @@index([isActive])
}

model TokenUsage {
  id                String   @id @default(cuid())
  date              DateTime // the day this record is for
  agentId           String
  agentName         String
  model             String
  totalInputTokens  Int      @default(0)
  totalOutputTokens Int      @default(0)
  totalTokens       Int      @default(0)
  estimatedCostUsd  Float    @default(0)
  apiCalls          Int      @default(0)
  failures          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date, agentId, model])
  @@index([date])
  @@index([agentId])
  @@index([model])
}

model WebhookConfig {
  id              String    @id @default(cuid())
  userId          String
  type            String    // "slack" | "discord" | "custom"
  url             String    // webhook URL
  events          String    // JSON array of event types to listen for
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isActive])
}

model VisibilityAlert {
  id        String   @id @default(cuid())
  userId    String
  domain    String   // the domain being monitored
  alertType String   // "citation_drop" | "ai_overview_lost" | "bot_blocked" | "score_change"
  severity  String   @default("warning") // info | warning | critical
  message   String
  data      String?  // JSON with alert details
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
  @@index([alertType])
  @@index([severity])
  @@index([isRead])
}

// ─── Enterprise SaaS Models ─────────────────────────────────────────

model Project {
  id            String    @id @default(cuid())
  userId        String
  url           String    // the website being tracked
  domain        String    // extracted domain
  targetMarket  String    @default("global")
  executionMode String    @default("co-pilot") // co-pilot | auto-pilot
  lastAnalysisAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses       Analysis[]
  tokenUsageLogs TokenUsageLog[]

  @@index([userId])
  @@index([domain])
}

// ─── Affiliate / Reseller System ──────────────────────────────────────

model Affiliate {
  id                    String    @id @default(cuid())
  userId                String    @unique
  affiliateCode         String    @unique  // e.g. "marko10", "seomaster"
  totalReferredActive   Int       @default(0) // count of currently active paid subscribers
  totalEarningsUsd      Float     @default(0) // lifetime earnings
  pendingPayoutUsd      Float     @default(0) // earnings not yet paid out
  status                String    @default("active") // active | suspended | paid_out
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts      AffiliatePayout[]
  referrals    AffiliateReferral[]

  @@index([affiliateCode])
  @@index([status])
}

model AffiliateReferral {
  id                String    @id @default(cuid())
  affiliateId       String
  referredUserId    String    @unique  // the user who was referred
  status            String    @default("registered") // registered | active | churned
  firstPaymentAt    DateTime? // when the referred user first paid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([referredUserId])
}

model AffiliatePayout {
  id                String    @id @default(cuid())
  affiliateId       String
  referredUserId    String    // the user whose payment generated this commission
  amountUsd         Float     // commission amount in USD
  percentageApplied Float     // e.g. 10.0, 20.0, 30.0, 40.0, 50.0
  sourceAmountUsd   Float     // the original payment amount that generated this commission
  status            String    @default("pending") // pending | paid | cancelled
  stripeTransferId  String?   // Stripe transfer ID once paid out
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model TokenUsageLog {
  id               String   @id @default(cuid())
  userId           String?  // nullable for anonymous scans
  projectId        String?  // nullable
  analysisId       String?  // nullable
  agentName        String   // e.g. "master_director", "competitor_analyst"
  modelUsed        String   // e.g. "gpt-4o", "claude-3-5-sonnet", "deepseek-v3"
  promptTokens     Int
  completionTokens Int
  costUsd          Float    // calculated cost: (prompt * model_price) + (completion * model_price)
  createdAt        DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([analysisId])
  @@index([agentName])
  @@index([modelUsed])
  @@index([createdAt])
  // Composite indexes for enterprise analytics (from SQL spec)
  @@index([userId, createdAt])       // idx_logs_user_time: per-user time-series for Superadmin dashboard
  @@index([agentName, modelUsed])    // idx_logs_agent_model: agent performance + cost per model
}

// ─── System Settings (Superadmin-managed config) ──────────────────────

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique   // e.g. "stripe_secret_key", "openai_api_key"
  value       String              // The setting value (encrypted at rest for secrets)
  category    String   @default("general") // "payment" | "ai" | "auth" | "general"
  isSecret    Boolean  @default(false)     // If true, value is masked in API responses
  description String?             // Human-readable description
  updatedAt   DateTime @updatedAt
  updatedBy   String?             // Who last changed it (superadmin email)

  @@index([key])
  @@index([category])
}

// ─── AI Visibility Feed & Monitoring ──────────────────────────────────

model VisibilitySnapshot {
  id            String   @id @default(cuid())
  userId        String?
  domain        String
  overallScore  Int      // AI Visibility Score 0-100
  trustScore    Int      @default(0)
  freshnessScore Int     @default(0)
  authorityScore Int     @default(0)
  perEngine     String   // JSON: { chatgpt: 72, claude: 55, gemini: 61, perplexity: 78, copilot: 48 }
  dataSource    String   @default("live") // live | estimated | simulation
  capturedAt    DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
  @@index([capturedAt])
  @@index([domain, capturedAt])
}

model CitationEvent {
  id          String   @id @default(cuid())
  userId      String?
  domain      String
  engine      String   // chatgpt | claude | gemini | perplexity | copilot
  eventType   String   // cited | uncited | rank_up | rank_down | first_mention | competitor_overtake
  delta       Int      @default(0)
  prompt      String?
  pageUrl     String?
  competitor  String?
  metadata    String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
  @@index([engine])
  @@index([eventType])
  @@index([createdAt])
  @@index([domain, createdAt])
}

model FeedItem {
  id          String   @id @default(cuid())
  userId      String?
  domain      String
  itemType    String   // citation_gained | citation_lost | rank_change | competitor_alert | new_entity | score_milestone | ai_discovery
  title       String
  description String
  engine      String?
  delta       Int      @default(0)
  severity    String   @default("info") // info | warning | positive | critical
  iconEmoji   String   @default("📊")
  isRead      Boolean  @default(false)
  metadata    String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
  @@index([itemType])
  @@index([isRead])
  @@index([createdAt])
  @@index([domain, createdAt])
}

model IndustryBenchmark {
  id              String   @id @default(cuid())
  industry        String   @unique
  industryLabel   String
  avgAIVisibility Int      @default(0)
  avgTrust        Int      @default(0)
  avgFreshness    Int      @default(0)
  avgAuthority    Int      @default(0)
  perEngine       String   // JSON
  sampleSize      Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@index([industry])
  @@index([avgAIVisibility])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  industry    String
  category    String
  prompt      String
  language    String   @default("en")
  isPopular   Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([industry])
  @@index([category])
  @@index([isPopular])
  @@index([language])
}

model ActionItem {
  id          String   @id @default(cuid())
  userId      String
  domain      String
  actionType  String   // fix_schema | create_faq | add_author | create_llms_txt | reddit_answer | g2_review | wikipedia | entity_fix | content_update | crawl_fix
  title       String
  description String
  priority    String   @default("medium") // low | medium | high | critical
  impact      String   @default("medium") // low | medium | high
  estimatedScoreGain Int @default(0)
  roiScore    Float    @default(0)
  effortMinutes Int    @default(0)
  queuePosition Int    @default(0)
  status      String   @default("pending") // pending | in_progress | completed | dismissed | queued | auto_executing | auto_executed | auto_failed
  relatedUrl  String?
  metadata    String?
  autoExecuteEnabled Boolean @default(false)
  autoExecutedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoExecutions AutoExecution[]

  @@index([userId])
  @@index([domain])
  @@index([status])
  @@index([priority])
  @@index([roiScore])
  @@index([createdAt])
}

model RecommendationSnapshot {
  id          String   @id @default(cuid())
  userId      String?
  domain      String
  prompt      String
  brand       String
  engines     String   // JSON: { chatgpt: { mentioned: true, position: 2, ... }, ... }
  overallScore Int     @default(0)
  dataSource  String   @default("live")
  capturedAt  DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  diffsAsBefore RecommendationDiff[] @relation("BeforeSnapshot")
  diffsAsAfter  RecommendationDiff[] @relation("AfterSnapshot")

  @@index([userId])
  @@index([domain])
  @@index([prompt])
  @@index([capturedAt])
  @@index([domain, capturedAt])
}

// ─── P1: AI Visibility Replay™ ───────────────────────────────────────

model ReplaySession {
  id            String   @id @default(cuid())
  userId        String
  domain        String
  title         String
  startDate     DateTime
  endDate       DateTime
  totalFrames   Int      @default(0)
  highlights    String?  // JSON array
  status        String   @default("ready") // ready | playing | completed
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
  @@index([startDate])
}

// ─── P1: AI Recommendation Recorder™ ─────────────────────────────────

model RecommendationDiff {
  id              String   @id @default(cuid())
  userId          String?
  domain          String
  beforeSnapshotId String
  afterSnapshotId  String
  prompt          String
  changes         String   // JSON: { gained, lost, positionChanges, scoreDelta }
  severity        String   @default("info")
  summary         String
  capturedAt      DateTime @default(now())

  beforeSnapshot  RecommendationSnapshot @relation("BeforeSnapshot", fields: [beforeSnapshotId], references: [id])
  afterSnapshot   RecommendationSnapshot @relation("AfterSnapshot", fields: [afterSnapshotId], references: [id])

  @@index([userId])
  @@index([domain])
  @@index([capturedAt])
}

// ─── P1: Auto Execute ────────────────────────────────────────────────

model AutoExecution {
  id              String   @id @default(cuid())
  actionItemId    String
  userId          String
  domain          String
  platform        String   // wordpress | webflow | shopify | custom
  actionType      String   // schema_update | meta_tag | content_publish | robots_update | redirect_create
  payload         String   // JSON
  result          String?  // JSON
  status          String   @default("pending") // pending | executing | success | failed | rolled_back
  attempts        Int      @default(0)
  lastAttemptAt   DateTime?
  completedAt     DateTime?
  errorMessage    String?
  rollbackPayload String?  // JSON
  createdAt       DateTime @default(now())

  actionItem      ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([actionItemId])
  @@index([userId])
  @@index([domain])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
}

// ─── P1: Email Digest "What changed overnight?" ──────────────────────

model EmailDigest {
  id              String   @id @default(cuid())
  userId          String
  domain          String
  digestType      String   @default("overnight") // overnight | weekly | monthly
  subject         String
  scoreBefore     Int      @default(0)
  scoreAfter      Int      @default(0)
  scoreDelta      Int      @default(0)
  citationsGained Int      @default(0)
  citationsLost   Int      @default(0)
  newOpportunities Int     @default(0)
  topOpportunity  String?  // JSON
  engineChanges   String?  // JSON
  feedHighlights  String?  // JSON
  sentAt          DateTime?
  status          String   @default("pending") // pending | sent | failed
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([domain])
  @@index([digestType])
  @@index([status])
  @@index([createdAt])
}

// ─── Superadmin: Event Tracking ─────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  userId      String?
  event       String   // started_audit | completed_audit | viewed_replay | opened_diff | connected_wordpress | executed_fix | opened_digest | clicked_upgrade | connected_gsc | registered | activated | paid
  domain      String?
  metadata    String?  // JSON with extra context
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@index([event, createdAt])
  @@index([userId, createdAt])
}

// ─── Superadmin: Daily Metrics Snapshot ────────────────────────────

model DailyMetric {
  id                  String   @id @default(cuid())
  date                DateTime // the day this record is for
  visitors            Int      @default(0)
  freeAudits          Int      @default(0)
  registrations       Int      @default(0)
  completedAudits     Int      @default(0)
  activatedUsers      Int      @default(0)
  paidUsers           Int      @default(0)
  mrr                 Float    @default(0)
  // Retention
  d1Retention         Float    @default(0) // percentage
  d7Retention         Float    @default(0)
  d30Retention        Float    @default(0)
  // Activation funnel
  auditStarted        Int      @default(0)
  gscConnected        Int      @default(0)
  fixExecuted         Int      @default(0)
  returnedNextDay     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// ─── Client Zero Content Engine™ ──────────────────────────────────────

model ContentBrief {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  topic               String
  keywordTarget       String
  pillar              String   @default("geo") // seo | aeo | geo | all
  cluster             String?
  suggestedTitle      String
  targetWordCount     Int      @default(2500)
  estimatedScoreGain  Int      @default(0)
  opportunitySource   String?  // Which data source identified this opportunity
  opportunityData     String?  // JSON: full opportunity context
  briefContent        String?  // JSON: structured editorial brief (outline, entities, FAQ, links, schema)
  status              String   @default("draft") // draft | approved | in_progress | completed | archived
  priority            String   @default("medium") // low | medium | high | critical
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  articles            ContentArticle[]

  @@index([domain])
  @@index([status])
  @@index([pillar])
  @@index([priority])
  @@index([createdAt])
}

model ContentArticle {
  id                  String   @id @default(cuid())
  briefId             String
  domain              String   @default("seosights.com")
  title               String
  slug                String?
  content             String?  // Full article body (markdown)
  wordCount           Int      @default(0)
  format              String   @default("blog") // blog | landing_page | case_study | linkedin | twitter_thread | newsletter | docs | vs_page
  pillar              String   @default("geo")  // seo | aeo | geo | all
  status              String   @default("draft") // draft | writing | review | approved | published | replay_scheduled | replayed | rewriting
  seoScore            Int      @default(0)
  aeoScore            Int      @default(0)
  geoScore            Int      @default(0)
  aiVisibilityGain    Int      @default(0)     // Measured after 24h replay
  publishedUrl        String?
  publishedAt         DateTime?
  schemaMarkup        String?  // JSON: generated schema (Article, FAQ, etc.)
  internalLinks       String?  // JSON: auto-generated internal links
  ogImageUrl          String?
  reviewResults       String?  // JSON: multi-agent review results
  metadata            String?  // JSON: additional metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  brief               ContentBrief     @relation(fields: [briefId], references: [id], onDelete: Cascade)
  reviews             ContentReview[]
  experimentVariants  ContentExperimentVariant[]

  @@index([briefId])
  @@index([domain])
  @@index([status])
  @@index([format])
  @@index([pillar])
  @@index([publishedAt])
  @@index([createdAt])
}

model ContentReview {
  id                  String   @id @default(cuid())
  articleId           String
  reviewerType        String   // seo_review | aeo_review | geo_review | fact_checker | citation_optimizer | internal_linker | schema_builder | image_generator
  status              String   @default("pending") // pending | passed | failed | needs_revision
  score               Int      @default(0)    // 0-100
  findings            String?  // JSON: structured findings (issues, suggestions, passes)
  autoFixes           String?  // JSON: automatic fixes applied
  confidence          Int      @default(0)    // 0-100 confidence score
  model               String?  // Which AI model was used
  tokensUsed          Int      @default(0)
  costUsd             Float    @default(0)
  reviewedAt          DateTime?
  createdAt           DateTime @default(now())

  article             ContentArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([reviewerType])
  @@index([status])
  @@index([reviewedAt])
}

model EditorialCalendarEntry {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  date                DateTime // The scheduled date
  dayOfWeek           Int      @default(1) // 1=Monday, 7=Sunday
  theme               String   // e.g. "Claude SEO Tuesdays", "AI Visibility Score Wednesdays"
  briefId             String?  // Linked brief if generated
  articleId           String?  // Linked article if written
  status              String   @default("scheduled") // scheduled | brief_generated | writing | review | published | skipped
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([domain, date])
  @@index([domain])
  @@index([date])
  @@index([status])
}

model ContentExperiment {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  title               String
  hypothesis          String
  metric              String   @default("ai_visibility") // ai_visibility | citations | organic_clicks | engagement
  status              String   @default("running") // running | completed | inconclusive
  startDate           DateTime @default(now())
  endDate             DateTime?
  winnerVariantId     String?  // ID of the winning variant
  results             String?  // JSON: experiment results
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  variants            ContentExperimentVariant[]

  @@index([domain])
  @@index([status])
  @@index([startDate])
}

model ContentExperimentVariant {
  id                  String   @id @default(cuid())
  experimentId        String
  articleId           String
  label               String   // "Version A" | "Version B"
  aiVisibilityBefore  Int      @default(0)
  aiVisibilityAfter   Int      @default(0)
  citationsBefore     Int      @default(0)
  citationsAfter      Int      @default(0)
  organicClicks       Int      @default(0)
  isWinner            Boolean  @default(false)
  createdAt           DateTime @default(now())

  experiment          ContentExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  article             ContentArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([articleId])
  @@index([isWinner])
}

model ContentKPI {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  date                DateTime
  articlesPublished   Int      @default(0)
  avgAIScoreGain      Float    @default(0)
  totalCitationGain   Int      @default(0)
  totalAIMentions     Int      @default(0)
  organicClicksDelta  Int      @default(0)
  articlesReplayed    Int      @default(0)
  articlesRewritten   Int      @default(0)
  autoExecuteRate     Float    @default(0)  // % of articles auto-published
  avgReviewScore      Float    @default(0)
  contentFactoryOutputs Int    @default(0)  // Total multi-format outputs
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([domain, date])
  @@index([domain])
  @@index([date])
}

model ContentDecisionLog {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  decisionType        String   // auto_publish | auto_rewrite | experiment_winner | topic_selection | review_override | replay_trigger
  context             String?  // JSON: decision context
  decision            String   // The actual decision made
  rationale           String?  // Why this decision was made
  impact              String?  // Measured impact after the fact
  automated           Boolean  @default(true) // true=AI decided, false=human decided
  articleId           String?
  createdAt           DateTime @default(now())

  @@index([domain])
  @@index([decisionType])
  @@index([automated])
  @@index([createdAt])
}

// ─── AI Growth Engine™ — Learning System ──────────────────────────────

model GrowthMemory {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  actionType          String   // created_faq | added_author | published_article | created_schema | added_internal_link | fixed_robots | updated_llms_txt | created_entity | added_citation_source
  actionDetail        String   // What was done, e.g. "Created FAQ: What is AI Visibility?"
  targetEntity        String?  // What entity/topic was affected, e.g. "AI Visibility for Dentists"
  visibilityDelta     Int      @default(0)     // Change in AI Visibility Score after this action
  citationDelta       Int      @default(0)     // Change in citations
  organicDelta        Int      @default(0)     // Change in organic traffic
  leadDelta           Int      @default(0)     // Change in leads attributed
  revenueDelta        Float    @default(0)     // Change in revenue attributed
  measuredAt          DateTime? // When the outcome was actually measured
  confidence          Int      @default(0)     // How confident we are that this action caused this outcome (0-100)
  articleId           String?  // Linked article if applicable
  briefId             String?  // Linked brief if applicable
  metadata            String?  // JSON: additional context
  createdAt           DateTime @default(now())

  @@index([domain])
  @@index([actionType])
  @@index([targetEntity])
  @@index([measuredAt])
  @@index([createdAt])
  @@index([domain, actionType])
  @@index([domain, createdAt])
}

model EvidenceEntry {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  recommendationType  String   // create_faq | add_author | publish_article | create_schema | fix_robots | etc.
  recommendation      String   // The recommendation text
  basedOnCompanies    Int      @default(0)     // How many companies' data supports this
  basedOnReplaySessions Int    @default(0)     // How many replay sessions
  basedOnCompetitors  Int      @default(0)     // How many competitor analyses
  basedOnArticles     Int      @default(0)     // How many published articles
  basedOnGrowthMemories Int    @default(0)     // How many growth memory entries
  avgVisibilityGain   Float    @default(0)     // Average visibility gain from this action type
  confidence          Int      @default(0)     // 0-100 confidence score
  sourceBreakdown     String?  // JSON: detailed source breakdown
  validUntil          DateTime? // When this evidence should be re-validated
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([domain])
  @@index([recommendationType])
  @@index([confidence])
  @@index([createdAt])
}

model KnowledgeNode {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  nodeType            String   // brand | founder | product | service | author | topic | entity | mention | source | industry | feature
  label               String
  description         String?
  url                 String?  // Associated URL
  properties          String?  // JSON: additional properties
  aiVisibilityImpact  Int      @default(0)     // How much this node contributes to AI visibility
  isComplete          Boolean  @default(false) // Whether this node has all required data
  missingData         String?  // JSON: what data is missing (e.g. ["wikipedia", "crunchbase", "reddit"])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  outgoingEdges       KnowledgeEdge[] @relation("SourceNode")
  incomingEdges       KnowledgeEdge[] @relation("TargetNode")

  @@index([domain])
  @@index([nodeType])
  @@index([label])
  @@index([isComplete])
  @@index([aiVisibilityImpact])
}

model KnowledgeEdge {
  id                  String   @id @default(cuid())
  sourceNodeId        String
  targetNodeId        String
  relationship        String   // owns | founded | covers | mentions | cites | competes_with | related_to | author_of | about | part_of
  strength            Int      @default(50)   // 0-100 how strong the relationship
  metadata            String?  // JSON: additional edge properties
  createdAt           DateTime @default(now())

  sourceNode          KnowledgeNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode          KnowledgeNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([relationship])
}

model Sprint {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  sprintNumber        Int      // Sequential sprint number
  goal                String   // e.g. "+10 AI Visibility"
  goalMetric          String   @default("ai_visibility") // ai_visibility | citations | organic_clicks | leads | revenue
  goalTarget          Float    // Target value
  currentValue        Float    @default(0)    // Current value at sprint start
  status              String   @default("planning") // planning | active | completed | failed
  aiPlan              String?  // JSON: AI-generated plan (3 articles, 2 FAQs, 1 schema, 5 links, etc.)
  plannedActions      String?  // JSON: detailed action plan
  executedActions     Int      @default(0)
  totalActions        Int      @default(0)
  resultSummary       String?  // JSON: results after sprint
  startedAt           DateTime?
  endsAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([domain])
  @@index([sprintNumber])
  @@index([status])
  @@index([endsAt])
}

model ArticleROI {
  id                  String   @id @default(cuid())
  articleId           String   @unique
  domain              String   @default("seosights.com")
  // Cost
  writingCostUsd      Float    @default(0)     // AI writing cost
  reviewCostUsd       Float    @default(0)     // Review pipeline cost
  totalCostUsd        Float    @default(0)     // Total cost
  writingTimeMinutes  Int      @default(0)     // Time from brief to published
  // Results
  visibilityBefore    Int      @default(0)     // AI Visibility Score before article
  visibilityAfter     Int      @default(0)     // AI Visibility Score after article
  visibilityDelta     Int      @default(0)
  citationsGained     Int      @default(0)
  organicClicks       Int      @default(0)
  leadsGenerated      Int      @default(0)
  revenueAttributed   Float    @default(0)
  // Calculated
  roi                 Float    @default(0)     // (revenue - cost) / cost
  costPerCitation     Float    @default(0)
  costPerLead         Float    @default(0)
  measuredAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([articleId])
  @@index([domain])
  @@index([roi])
  @@index([measuredAt])
}

model AIDailyRecommendation {
  id                  String   @id @default(cuid())
  domain              String   @default("seosights.com")
  date                DateTime // The date this recommendation is for
  priority            Int      @default(1)     // 1=highest priority
  category            String   // content | technical | entity | link | schema | experiment
  recommendation      String   // The actual recommendation text
  rationale           String   // Why this is recommended
  evidenceId          String?  // Linked EvidenceEntry
  evidenceSummary     String?  // Quick evidence summary
  confidence          Int      @default(0)     // 0-100
  estimatedImpact     String?  // e.g. "+4 AI Visibility"
  effortMinutes       Int      @default(0)     // Estimated effort
  status              String   @default("pending") // pending | accepted | rejected | executing | completed
  executedAt          DateTime?
  resultNote          String?  // What happened after execution
  createdAt           DateTime @default(now())

  @@index([domain])
  @@index([date])
  @@index([status])
  @@index([priority])
  @@index([category])
}
