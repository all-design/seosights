// ─── AI Visibility Observatory™ ─────────────────────────────────────────

// Layer 1: Data Collection — Crawl sessions that query AI models
model ObservatoryCrawl {
  id              String   @id @default(cuid())
  type            String   @default("daily")  // daily | weekly | monthly | manual
  status          String   @default("running") // running | completed | failed | partial
  modelsQueried   Int      @default(0)         // How many AI models were queried
  promptsTotal    Int      @default(0)         // Total prompts sent
  promptsCompleted Int     @default(0)         // Successfully completed
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?                         // Crawl duration in milliseconds
  errorLog        String?                      // Any errors encountered
  createdAt       DateTime @default(now())

  responses       ObservatoryResponse[]
  changes         ObservatoryChange[]

  @@index([type])
  @@index([status])
  @@index([startedAt])
}

// Layer 1: Individual AI model responses — the AI Search Archive™ dataset
model ObservatoryResponse {
  id              String   @id @default(cuid())
  crawlId         String
  aiModel         String   // chatgpt | claude | gemini | perplexity | grok | deepseek
  promptCategory  String   // brand_query | industry_query | competitive_query | factual_query | recommendation_query
  promptText      String   // The exact prompt sent
  responseText    String   // The AI model's response
  citationsJson   String?  // JSON array of cited sources/domains
  sentimentScore  Float?   // -1 to 1 sentiment towards the topic
  confidenceScore Float?   // 0-1 how confident the model seems
  responseTimeMs  Int?     // How long the model took to respond
  tokensUsed      Int?     // Token count
  metadataJson    String?  // Additional metadata as JSON
  answerHash      String?  // SHA-256 hash of responseText for quick change detection
  isSimulated     Boolean  @default(false) // CRITICAL: true = seed/dev data, NEVER publish publicly
  createdAt       DateTime @default(now())

  crawl           ObservatoryCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  citations       CitationRecord[]

  @@index([crawlId])
  @@index([aiModel])
  @@index([promptCategory])
  @@index([createdAt])
  @@index([answerHash])
  @@index([isSimulated])
}

// Layer 2: Detected changes between crawls
model ObservatoryChange {
  id                String   @id @default(cuid())
  crawlId           String   // The crawl where this change was detected
  previousCrawlId   String?  // The crawl being compared against
  aiModel           String   // Which AI model changed
  changeType        String   // citation_shift | sentiment_shift | source_shift | ranking_change | new_capability | behavior_change
  category          String   // What domain/topic this relates to
  beforeSummary     String   // What the model said/did before
  afterSummary      String   // What the model says/does now
  significanceScore Float    @default(0)  // 0-1 how significant this change is
  detailsJson       String?  // Detailed change data as JSON
  isSignal          Boolean  @default(false) // Whether this passes the signal threshold
  signalReason      String?  // Why it is/isn't a signal
  createdAt         DateTime @default(now())

  crawl             ObservatoryCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([aiModel])
  @@index([changeType])
  @@index([isSignal])
  @@index([significanceScore])
  @@index([createdAt])
}

// Layer 3-4: Reports generated from signals — only data-backed findings
model ObservatoryReport {
  id              String   @id @default(cuid())
  slug            String   @unique  // URL-friendly slug: /research/chatgpt-update-july-2026
  title           String
  type            String   @default("research") // research | benchmark | industry_update | monthly_report | breaking
  status          String   @default("draft") // draft | proposed | approved | published | archived
  editorialScore  Float    @default(0)  // 0-1 editorial AI score
  editorialReason String?  // Why it was approved/rejected
  aiModels        String?  // JSON array of relevant AI models
  categories      String?  // JSON array of categories
  contentJson     String?  // Full content as structured JSON (sections, data, charts)
  contentMarkdown String?  // Full content as markdown
  summary         String?  // Executive summary
  keyFindings     String?  // JSON array of key findings
  relatedChanges  String?  // JSON array of ObservatoryChange IDs
  relatedReports  String?  // JSON array of related report IDs
  coverImageUrl   String?
  publishedAt     DateTime?
  wordCount       Int      @default(0)
  readingTimeMin  Int      @default(0)
  evidenceScore   Float    @default(0)  // 0-100 quality of evidence
  confidenceScore Float    @default(0)  // 0-100 confidence in findings
  freshnessScore  Float    @default(0)  // 0-100 how recent the data is
  sampleSize      Int      @default(0) // Number of prompts/data points
  researchQualityScore Float @default(0) // 0-100 overall Observatory Score™
  isBreaking      Boolean  @default(false) // Whether this is Breaking Research 🚨
  breakingAlertId String?  // Link to BreakingResearch
  methodologyJson String?  // CRITICAL: Methodology transparency — queries, models, period, significance criteria
  methodologyVersion String?  // e.g., "v1.4" — versioned methodology for reproducibility tracking
  promptSet       String?  // e.g., "2026-07" — which prompt set was used
  modelsStudied   String?  // JSON array: ["Claude 4", "Gemini", "GPT-5"] — exact models tested
  studyPeriod     String?  // e.g., "30 days" — the time period covered
  significanceCriteria String? // Criteria used to determine significance of findings
  doi             String?  // Observatory DOI: OBS-2026-0042 — citable research identifier
  confidenceDistribution String? // JSON: {"90plus": 42, "80plus": 18, "70plus": 5, "60plus": 2, "below60": 1}
  permanentUrl    String?  // Permanent URL: /research/2026/07/chatgpt-github-citations — never changes
  citedByCount    Int      @default(0) // Number of external citations of this research
  citedBySources  String?  // JSON: ["HubSpot", "Search Engine Land", "Ahrefs"] — who cited this
  isSimulated     Boolean  @default(false) // CRITICAL: true = seed/dev data, NEVER publish publicly
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  publications    ObservatoryPublication[]
  learning        ObservatoryLearning[]
  externalCitations ObservatoryExternalCitation[]

  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([editorialScore])
  @@index([publishedAt])
  @@index([isBreaking])
  @@index([isSimulated])
  @@index([doi])
  @@index([methodologyVersion])
  @@index([createdAt])
}

// Layer 5: Publishing tracking
model ObservatoryPublication {
  id              String   @id @default(cuid())
  reportId        String
  channel         String   // website | linkedin | newsletter | twitter | pdf | api
  status          String   @default("pending") // pending | published | failed
  publishedUrl    String?  // URL where it was published
  publishedAt     DateTime?
  reachEstimate   Int?     // Estimated reach
  errorLog        String?
  metadataJson    String?
  createdAt       DateTime @default(now())

  report          ObservatoryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([channel])
  @@index([status])
  @@index([publishedAt])
}

// Layer 6: Internal Learning / Growth Memory
model ObservatoryLearning {
  id              String   @id @default(cuid())
  reportId        String
  metric          String   // citations | ai_visibility | traffic | leads | conversions | backlinks
  value           Float    @default(0)
  previousValue   Float?   // For delta calculation
  measuredAt      DateTime @default(now())
  source          String   // analytics | manual | api | crawl
  notes           String?
  createdAt       DateTime @default(now())

  report          ObservatoryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([metric])
  @@index([measuredAt])
}

// Observatory Index™: Industry pages with trend data
model ObservatoryIndustry {
  id              String   @id @default(cuid())
  slug            String   @unique  // /industry/dentists
  name            String   // Display name: "Dentists"
  description     String?
  indexScore      Float    @default(0)  // 0-100 Observatory Index™ score
  previousScore   Float    @default(0)  // Previous period score for delta
  trend           String   @default("stable") // rising | falling | stable
  aiVisibilityAvg Float    @default(0)  // Average AI Visibility score for this industry
  topModelsJson   String?  // JSON: which AI models rank which businesses
  rankingsJson    String?  // JSON: top businesses by AI visibility
  benchmarksJson  String?  // JSON: industry benchmarks
  dataPoints      Int      @default(0)  // Number of data points supporting this score
  signalsCount    Int      @default(0)  // Number of recent signals
  lastUpdated     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([indexScore])
  @@index([trend])
  @@index([aiVisibilityAvg])
  @@index([lastUpdated])
}

// AI Model Registry — tracks all known AI models and their metadata
model AIModelRegistry {
  id              String   @id @default(cuid())
  modelId         String   @unique  // chatgpt | claude | gemini | perplexity | grok | deepseek
  displayName     String   // ChatGPT | Claude | Gemini | Perplexity | Grok | DeepSeek
  provider        String   // openai | anthropic | google | perplexity | xai | deepseek
  version         String?  // Current known version
  capabilities    String?  // JSON: {web_access: true, citation: true, reasoning: true}
  lastCrawledAt   DateTime?
  totalResponses  Int      @default(0)
  knownChanges    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([modelId])
  @@index([provider])
  @@index([isActive])
}

// ─── AI Citation Warehouse™ ─────────────────────────────────────────

// Every individual citation from AI model responses — the core dataset
model CitationRecord {
  id              String   @id @default(cuid())
  responseId      String?  // Link to ObservatoryResponse (nullable for manual entries)
  aiModel         String   // chatgpt | claude | gemini | perplexity | grok | deepseek
  promptText      String   // The prompt that generated this citation
  citedUrl        String   // The URL cited by the AI model
  citedDomain     String   // Extracted domain (e.g., "github.com")
  citedTitle      String?  // Title of the cited page
  citedSnippet    String?  // The snippet/quote the AI used from the source
  citationOrder   Int      @default(0)  // Position in the response (1st, 2nd, etc.)
  promptCategory  String   // brand_query | industry_query | competitive_query | factual_query | recommendation_query
  entities        String?  // JSON array of named entities mentioned (e.g., ["SeoSights", "ChatGPT"])
  answerHash      String?  // SHA-256 hash of the response for change detection
  confidence      Float    @default(0)  // 0-1 how confident the model was
  crawlDate       DateTime // When this was collected
  createdAt       DateTime @default(now())

  response        ObservatoryResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([aiModel])
  @@index([citedDomain])
  @@index([promptCategory])
  @@index([answerHash])
  @@index([crawlDate])
  @@index([createdAt])
}

// Source tracking — aggregated domain statistics over time
model SourceTracking {
  id              String   @id @default(cuid())
  domain          String   // e.g., "github.com", "reddit.com", "wikipedia.org"
  aiModel         String   // Which AI model
  period          String   // "2026-06" or "2026-W26" for weekly
  citationCount   Int      @default(0)  // How many times this domain was cited
  previousCount   Int      @default(0)  // Previous period count for delta
  percentChange   Float    @default(0)  // Percentage change
  avgPosition     Float    @default(0)  // Average citation position (lower = more prominent)
  categories      String?  // JSON: which prompt categories cite this domain
  trend           String   @default("stable")  // rising | falling | stable | new
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([domain, aiModel, period])
  @@index([domain])
  @@index([aiModel])
  @@index([period])
  @@index([trend])
  @@index([percentChange])
}

// Breaking Research alerts — real-time notifications of major changes
model BreakingResearch {
  id              String   @id @default(cuid())
  changeId        String?  // Link to ObservatoryChange
  headline        String   // "Claude stopped citing Reddit"
  summary         String   // One-sentence data-backed finding
  aiModel         String   // Which model changed
  changeType      String   // citation_shift | source_shift | behavior_change | new_capability
  evidenceCount   Int      @default(0)  // How many prompts support this
  confidence      Float    @default(0)  // 0-1
  significance    Float    @default(0)  // 0-1
  sourceBefore    String?  // What was happening before
  sourceAfter     String?  // What's happening now
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([aiModel])
  @@index([changeType])
  @@index([isPublished])
  @@index([significance])
  @@index([createdAt])
}

// ─── AI Search Weather™ ──────────────────────────────────────────

// Daily weather snapshot per AI model — the daily indicator
model ObservatoryWeatherDaily {
  id              String   @id @default(cuid())
  date            DateTime // The date this weather applies to
  aiModel         String   // chatgpt | claude | gemini | perplexity | grok | deepseek | overall
  stabilityIndex  Float    @default(0)  // 0-100: 100 = perfectly stable, 0 = chaos
  volatility      Float    @default(0)  // 0-100: inverse of stability, how much changed
  trend           String   @default("stable") // stable | high_volatility | low_volatility | recovering
  changesCount    Int      @default(0)  // Number of detected changes today
  citationShifts  Int      @default(0)  // Citation-level changes
  sourceShifts    Int      @default(0)  // Source-level shifts
  newCapabilities Int      @default(0)  // New capabilities detected
  avgSignificance Float    @default(0)  // Average significance of changes
  previousStability Float  @default(0)  // Yesterday's stability for delta
  createdAt       DateTime @default(now())

  @@unique([date, aiModel])
  @@index([date])
  @@index([aiModel])
  @@index([stabilityIndex])
  @@index([trend])
}

