{
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": ".next",
  "crons": [
    { "path": "/api/cron/daily-mission", "schedule": "0 6 * * *" },
    { "path": "/api/cron/observatory-daily", "schedule": "0 2 * * *" },
    { "path": "/api/cron/observatory-weekly", "schedule": "0 3 * * 1" },
    { "path": "/api/cron/observatory-monthly", "schedule": "0 4 1 * *" },
    { "path": "/api/cron/digest", "schedule": "30 5 * * *" },
    { "path": "/api/cron/auto-outreach", "schedule": "0 8 * * 1-5" },
    { "path": "/api/cron/auto-publish", "schedule": "0 9 * * 1-5" },
    { "path": "/api/cron/cluster-map", "schedule": "0 3 * * 0" }
  ],
  "functions": {
    "src/app/api/analyze/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/audit/run/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/audit/[jobId]/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/analysis/[id]/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/content-engine/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/observatory/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=10, stale-while-revalidate=59" }
      ]
    }
  ]
}
